# ---- Frontend (copy to .env.local) ----
# 46630 = Robinhood Chain Testnet (default), 4663 = mainnet, 31337 = local Hardhat
NEXT_PUBLIC_CHAIN_ID=46630
# Optional read RPC override (e.g. an Alchemy/QuickNode URL). Wallet RPC is used once connected.
NEXT_PUBLIC_RPC_URL=
# Printed by `pnpm deploy:testnet`
NEXT_PUBLIC_VAULT_GME=
NEXT_PUBLIC_VAULT_NVDA=
NEXT_PUBLIC_VAULT_TSLA=
NEXT_PUBLIC_VAULT_WEALD=
# $WEALD token contract address, shown as the "CA" button.
# Leave empty to use the official mainnet CA 0x6a725216978E452a733aBc2dcDBb69C6575468c1.
NEXT_PUBLIC_WEALD_TOKEN=
# Equity Basket vault, printed by `pnpm deploy:basket:testnet`
NEXT_PUBLIC_BASKET_VAULT=

# ---- Project links (optional overrides; defaults are the official accounts) ----
NEXT_PUBLIC_X_URL=https://x.com/Hedgerowft
NEXT_PUBLIC_WEBSITE_URL=https://www.hedgerow.click/

# ---- Contract deployment (shell env only, never commit) ----
# DEPLOYER_PRIVATE_KEY=0x...
# RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
# RH_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
